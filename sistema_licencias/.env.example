# Copiar a .env y completar. Nunca subir .env al repositorio.
# Generar claves con: python scripts/generate_env.py

APP_NAME=TramitesBAR
APP_VERSION=1.0.0
APP_ENV=development
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
LOG_LEVEL=INFO

# MySQL 8.4. El usuario debe tener permisos solo sobre esta base.
DATABASE_URL=mysql+pymysql://tramites_app:CAMBIAR@127.0.0.1:3306/tramites_bar?charset=utf8mb4
REDIS_URL=

# Claves de 32 bytes o más. ENCRYPTION_KEY es base64 de 32 bytes.
SECRET_KEY=
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=k1
DNI_HMAC_KEY=

# Cookies. En producción COOKIE_SECURE=true y SameSite=lax o strict.
SESSION_COOKIE_NAME=tb_session
CSRF_COOKIE_NAME=tb_csrf
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

TRUSTED_HOSTS=127.0.0.1,localhost
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRUST_PROXY_HEADERS=false

UPLOAD_DIR=storage
MAX_UPLOAD_MB=10
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=tramitesbar
S3_REGION=us-east-1
S3_SECURE=false

EMAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TramitesBAR <no-reply@baradero.gob.ar>
SMTP_TLS=true
OUTBOX_POLL_SECONDS=5
MAINTENANCE_INTERVAL_MINUTES=60

PAYMENT_SECOND_APPROVAL_THRESHOLD=100000.00
EXAM_PASS_RATIO=0.8

# El municipio completa estos datos. No se inventan.
PAYMENT_ALIAS=
PAYMENT_CBU=
PAYMENT_HOLDER=
PAYMENT_BANK=

# Funciones que requieren aprobación externa.
FEATURES_MINORS=false
FEATURES_PROCTORING=false
FEATURES_DNI_OCR=false

OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=8

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

SENTRY_DSN=
